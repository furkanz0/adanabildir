# Firebase Console > Proje Ayarlari > Genel > "Uygulamalariniz" > Web uygulamasi
# bolumundeki firebaseConfig nesnesindeki degerleri buraya yapistirin.
# Bu dosyayi .env olarak kopyalayin ve degerleri doldurun.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary - gorsel yukleme (ucretsiz, kredi karti gerektirmez)
# cloudinary.com > Dashboard > "Cloud name"
# cloudinary.com > Settings > Upload > Upload presets > "Add upload preset"
#   Signing Mode: Unsigned secip preset adini asagiya yazin.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Admin panelini (/admin) gorebilecek tek e-posta adresi
VITE_ADMIN_EMAIL=
